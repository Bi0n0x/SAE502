package views

import "github.com/casino-rt/backend/internal/web"

templ Layout(p Page) {
	<!DOCTYPE html>
	<html lang="fr">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="dark"/>
			<meta name="htmx-config" content='{"includeIndicatorStyles":false}'/>
			<title>
				if p.Title != "" {
					{ p.Title } · Casino R&T
				} else {
					Casino R&T
				}
			</title>
			<link rel="icon" href={ web.Asset("favicon.svg") } type="image/svg+xml"/>
			<link rel="preload" href="/static/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="stylesheet" href={ web.Asset("casino-rt.css") }/>
			<script src={ web.Asset("htmx.min.js") } defer></script>
			<script src={ web.Asset("casino-rt.js") } defer></script>
		</head>
		<body
			if p.Game != "" {
				data-game={ p.Game }
			}
		>
			<a class="skip" href="#contenu">Aller au contenu</a>
			<header class="top">
				<a class="logo" href="/">
					<img src={ web.Asset("img/logo.webp") } alt="" width="28" height="28"/>
					<span>Casino <b>R&T</b></span>
				</a>
				<nav class="nav" aria-label="Navigation principale">
					@navLink("/", "Jeux", p.Active == "jeux")
					@navLink("/classement", "Classement", p.Active == "classement")
					if p.User == nil {
						<a href="/connexion">Connexion</a>
					}
				</nav>
				<div class="account">
					if p.User != nil {
						@Balance(*p.User, false)
						<a
							class="who"
							href="/profil"
							title="Profil"
							if p.Active == "profil" {
								aria-current="page"
							}
						>
							<span class="avatar" aria-hidden="true">{ initials(p.User.Name) }</span>
							<span class="name">{ p.User.Name }</span>
						</a>
					} else {
						<a class="btn btn-primary" href="/inscription">Créer un compte</a>
					}
				</div>
			</header>
			<main class="wrap" id="contenu" tabindex="-1">
				{ children... }
			</main>
			<footer class="foot">
				Crédits fictifs, aucun argent réel. Projet SAE 5.02, BUT R&T.
			</footer>
		</body>
	</html>
}

templ navLink(href, label string, active bool) {
	<a
		href={ templ.SafeURL(href) }
		if active {
			aria-current="page"
		}
	>{ label }</a>
}

// Balance is the credit chip in the header. With oob it is sent next to a game
// stage so htmx swaps it in place.
templ Balance(u User, oob bool) {
	<span
		id="balance"
		class="credits"
		title="Solde"
		if oob {
			hx-swap-oob="true"
		}
	>
		<img class="coin" src={ web.Asset("img/coin.webp") } alt="" width="16" height="16"/>
		<span class="sr-only">Solde :</span>
		if u.animated() {
			<span class="roll" style={ css("--delay:%s", seconds(u.Delay)) }>
				<span class="old" aria-hidden="true">{ credits(u.Previous) }</span>
				<span class={ "new", templ.KV("gain", u.Balance > u.Previous), templ.KV("loss", u.Balance < u.Previous) }>{ credits(u.Balance) }</span>
			</span>
		} else {
			<span>{ credits(u.Balance) }</span>
		}
	</span>
}

templ ErrorPage(p Page, code int, message string) {
	@Layout(p) {
		<section class="error-page">
			<p class="error-code" aria-hidden="true">{ itoa(code) }</p>
			<p class="kicker">Erreur { itoa(code) }</p>
			<h1>{ message }</h1>
			<div class="lobby-actions">
				<a class="btn btn-primary btn-lg" href="/">Retour aux jeux</a>
				if p.User == nil {
					<a class="btn btn-secondary btn-lg" href="/connexion">Connexion</a>
				}
			</div>
		</section>
	}
}
