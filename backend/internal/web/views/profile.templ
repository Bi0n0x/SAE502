package views

type Totals struct {
	Rounds     int64
	Wagered    int64
	Won        int64
	Net        int64
	WinRate    float64
	ReturnRate float64
}

type GameStat struct {
	Name    string
	Rounds  int64
	Wagered int64
	Net     int64
	WinRate float64
	BestWin int64
}

type HistoryRow struct {
	When         string
	Game         string
	Bet          int64
	Label        string
	Net          int64
	BalanceAfter int64
}

type Profile struct {
	Balance int64
	Total   Totals
	PerGame []GameStat
	History []HistoryRow
	Page    int
	Pages   int
}

templ ProfilePage(p Page, pr Profile) {
	@Layout(p) {
		<section class="profile-head">
			<span class="avatar avatar-xl" aria-hidden="true">{ initials(p.User.Name) }</span>
			<div class="profile-id">
				<p class="kicker">Profil</p>
				<h1>{ p.User.Name }</h1>
			</div>
			<div class="profile-balance">
				<span class="muted">Solde</span>
				<b>{ credits(pr.Balance) }</b>
			</div>
			<form method="post" action="/deconnexion" class="profile-out">
				<button class="btn btn-secondary" type="submit">Déconnexion</button>
			</form>
		</section>
		<section class="stats" aria-label="Statistiques">
			<div class={ "stat", "stat-net", netClass(pr.Total.Net) }>
				<span>Net</span>
				<b>{ signed(pr.Total.Net) }</b>
				<small class="muted">sur { credits(pr.Total.Wagered) } misés</small>
			</div>
			@stat("Parties", i64(pr.Total.Rounds), "")
			@stat("Misé", credits(pr.Total.Wagered), "")
			@stat("Taux de retour", percent(pr.Total.ReturnRate), "")
			<div class="stat">
				<span>Parties gagnées</span>
				<b>{ percent(pr.Total.WinRate) }</b>
				@meter(pr.Total.WinRate)
			</div>
		</section>
		if len(pr.PerGame) > 0 {
			<section class="block">
				<h2>Par jeu</h2>
				<div class="panel panel-flush scroll">
					<table class="table game-stats">
						<thead>
							<tr>
								<th scope="col">Jeu</th>
								<th scope="col" class="num">Parties</th>
								<th scope="col" class="num">Misé</th>
								<th scope="col" class="num">Net</th>
								<th scope="col" class="num">Gagnées</th>
								<th scope="col" class="num">Meilleur coup</th>
							</tr>
						</thead>
						<tbody>
							for _, g := range pr.PerGame {
								<tr>
									<td>{ g.Name }</td>
									<td class="num" data-label="Parties">{ i64(g.Rounds) }</td>
									<td class="num" data-label="Misé">{ credits(g.Wagered) }</td>
									<td class={ "num", netClass(g.Net) } data-label="Net">{ signed(g.Net) }</td>
									<td class="num" data-label="Gagnées">{ percent(g.WinRate) }</td>
									<td class="num" data-label="Meilleur coup">{ signed(g.BestWin) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</section>
		}
		<section class="block" id="historique">
			<h2>Historique</h2>
			if len(pr.History) == 0 {
				@emptyState("Aucune partie pour l'instant.", "Vos parties s'afficheront ici, avec le solde après chaque mise.", "/", "Choisir un jeu")
			} else {
				<div class="panel panel-flush scroll">
					<table class="table history">
						<thead>
							<tr>
								<th scope="col">Date</th>
								<th scope="col">Jeu</th>
								<th scope="col" class="num">Mise</th>
								<th scope="col">Résultat</th>
								<th scope="col" class="num">Net</th>
								<th scope="col" class="num">Solde</th>
							</tr>
						</thead>
						<tbody>
							for _, h := range pr.History {
								<tr>
									<td class="muted">{ h.When }</td>
									<td>{ h.Game }</td>
									<td class="num" data-label="Mise">{ credits(h.Bet) }</td>
									<td><span class={ "tag", outcomeTag(h.Net) }>{ h.Label }</span></td>
									<td class={ "num", netClass(h.Net) }>{ signed(h.Net) }</td>
									<td class="num" data-label="Solde">{ credits(h.BalanceAfter) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
				if pr.Pages > 1 {
					<nav class="pager" aria-label="Pages de l'historique">
						if pr.Page > 1 {
							<a class="btn btn-secondary" rel="prev" href={ templ.SafeURL("/profil?page=" + itoa(pr.Page-1) + "#historique") }><span aria-hidden="true">←</span> Plus récentes</a>
						} else {
							<span class="btn btn-secondary" aria-disabled="true"><span aria-hidden="true">←</span> Plus récentes</span>
						}
						<span class="pager-pos">Page <b>{ itoa(pr.Page) }</b> sur { itoa(pr.Pages) }</span>
						if pr.Page < pr.Pages {
							<a class="btn btn-secondary" rel="next" href={ templ.SafeURL("/profil?page=" + itoa(pr.Page+1) + "#historique") }>Plus anciennes <span aria-hidden="true">→</span></a>
						} else {
							<span class="btn btn-secondary" aria-disabled="true">Plus anciennes <span aria-hidden="true">→</span></span>
						}
					</nav>
				}
			}
		</section>
	}
}

templ stat(label, value, class string) {
	<div class="stat">
		<span>{ label }</span>
		<b class={ class }>{ value }</b>
	</div>
}

// meter draws a share between 0 and 1 as a thin bar.
templ meter(share float64) {
	<span class="meter" aria-hidden="true"><i style={ css("width:%.1f%%", min(max(share, 0), 1)*100) }></i></span>
}
